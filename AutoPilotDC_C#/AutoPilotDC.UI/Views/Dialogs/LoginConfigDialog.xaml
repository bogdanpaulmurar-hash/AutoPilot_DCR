<Window x:Class="AutoPilotDC.UI.Views.Dialogs.LoginConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Configurare Login Rutina"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1B2E">

    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#009999"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🔐 Login Rutina" FontSize="18" FontWeight="Bold"
                       Foreground="#009999"/>
            <TextBlock Text="Configureaza autentificarea automata inainte de rularea rutinei."
                       Foreground="#B0B0C4" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Enabled + Mode -->
        <StackPanel Grid.Row="1">
            <CheckBox x:Name="ChkEnabled"
                      Content="Activeaza login automat"
                      Foreground="#E0E0E0" FontSize="13"
                      Checked="ChkEnabled_Changed"
                      Unchecked="ChkEnabled_Changed"/>

            <TextBlock Text="Mod autentificare:" Style="{StaticResource LabelStyle}" Margin="0,10,0,2"/>
            <ComboBox x:Name="CmbMode"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="CmbMode_SelectionChanged">
                <ComboBoxItem Content="none — Fara login"              Tag="none"/>
                <ComboBoxItem Content="credentials — User + Parola"    Tag="credentials" IsSelected="True"/>
                <ComboBoxItem Content="entra_id — Microsoft Entra ID"  Tag="entra_id"/>
                <ComboBoxItem Content="session_reuse — Reutilizare sesiune" Tag="session_reuse"/>
            </ComboBox>
        </StackPanel>

        <!-- Dynamic panels -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>

                <!-- Panel: none -->
                <StackPanel x:Name="PnlNone" Visibility="Collapsed">
                    <Border Background="#252540" CornerRadius="4" Padding="12" Margin="0,4">
                        <TextBlock Text="Niciun login automat. Rutina porneste direct."
                                   Foreground="#B0B0C4" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Panel: credentials -->
                <StackPanel x:Name="PnlCredentials" Visibility="Visible">
                    <TextBlock Text="Credentiale" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="URL Login:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtLoginUrl" Style="{StaticResource DarkTextBox}"
                             Text="https://"/>

                    <TextBlock Text="Username / Email:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtUsername" Style="{StaticResource DarkTextBox}"/>

                    <TextBlock Text="Parola:" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="PbPassword" Style="{StaticResource DarkPasswordBox}"/>

                    <TextBlock Text="Selector camp Username (CSS):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtUsernameSelector" Style="{StaticResource DarkTextBox}"
                             Text="#username"/>

                    <TextBlock Text="Selector camp Parola (CSS):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtPasswordSelector" Style="{StaticResource DarkTextBox}"
                             Text="#password"/>

                    <TextBlock Text="Selector buton Submit (CSS):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtSubmitSelector" Style="{StaticResource DarkTextBox}"
                             Text="button[type='submit']"/>

                    <TextBlock Text="Selector confirmare succes (optional):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtSuccessSelector" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- Panel: entra_id -->
                <StackPanel x:Name="PnlEntraId" Visibility="Collapsed">
                    <TextBlock Text="Microsoft Entra ID (SSO)" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="URL Login:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtEntraLoginUrl" Style="{StaticResource DarkTextBox}"
                             Text="https://login.microsoftonline.com"/>

                    <TextBlock Text="Tenant ID:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtTenantId" Style="{StaticResource DarkTextBox}"/>

                    <TextBlock Text="Client ID:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtClientId" Style="{StaticResource DarkTextBox}"/>

                    <TextBlock Text="Username (email):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtEntraUsername" Style="{StaticResource DarkTextBox}"/>

                    <TextBlock Text="Selector confirmare succes (optional):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtEntraSuccessSelector" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- Panel: session_reuse -->
                <StackPanel x:Name="PnlSessionReuse" Visibility="Collapsed">
                    <TextBlock Text="Reutilizare Sesiune Browser" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Cale profil browser (optional):" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtProfilePath" Style="{StaticResource DarkTextBox}"
                                 Grid.Column="0"/>
                        <Button Content="..." Grid.Column="1" Width="30" Height="30"
                                Margin="4,0,0,0" Click="BtnBrowseProfile_Click"
                                Background="#333355" Foreground="White" BorderThickness="0"/>
                    </Grid>

                    <CheckBox x:Name="ChkReuseSession"
                              Content="Reutilizare sesiune existenta"
                              Foreground="#E0E0E0" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Timeout — vizibil pentru orice mod != none -->
                <StackPanel x:Name="PnlTimeout" Visibility="Visible">
                    <TextBlock Text="Timeout (secunde):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtTimeout" Style="{StaticResource DarkTextBox}"
                             Width="100" HorizontalAlignment="Left" Text="30"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="BtnTest" Content="🧪 Testeaza Login" Width="140" Height="34"
                    Margin="0,0,8,0" Click="BtnTest_Click"
                    Background="#005F5F" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnSave" Content="💾 Salveaza" Width="100" Height="34"
                    Margin="0,0,8,0" Click="BtnSave_Click"
                    Background="#007777" Foreground="White" BorderThickness="0"/>
            <Button Content="Anuleaza" Width="90" Height="34"
                    Click="BtnCancel_Click"
                    Background="#444466" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

