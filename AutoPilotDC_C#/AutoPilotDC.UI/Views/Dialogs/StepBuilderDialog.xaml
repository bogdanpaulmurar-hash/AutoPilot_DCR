<!-- ============================================================
     AutoPilot DC v3.9 -> C# WPF .NET 8
     StepBuilderDialog.xaml — Faza 8: Mouse Position Tracker
     Modificat: adaugat MouseTracker in PanelMouse (dupa Grid X/Y + Buton)
     ============================================================ -->
<Window x:Class="AutoPilotDC.UI.Views.Dialogs.StepBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step Builder — AutoPilot DC"
        Width="560" Height="660"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgMainBrush}"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Step Type -->
            <RowDefinition Height="Auto"/>  <!-- Description -->
            <RowDefinition Height="*"/>     <!-- Dynamic fields -->
            <RowDefinition Height="Auto"/>  <!-- Common fields -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Step Type -->
        <GroupBox Grid.Row="0" Header="Tip pas" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,8">
            <ComboBox x:Name="CmbStepType"
                      Style="{DynamicResource DarkComboBoxStyle}"
                      SelectionChanged="CmbStepType_SelectionChanged"
                      Margin="0,4"/>
        </GroupBox>

        <!-- Description -->
        <GroupBox Grid.Row="1" Header="Descriere" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,8">
            <TextBox x:Name="TxtDescription"
                     Style="{DynamicResource DarkTextBoxStyle}"
                     Margin="0,4"/>
        </GroupBox>

        <!-- Dynamic fields panel -->
        <GroupBox Grid.Row="2" Header="Parametri pas" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DynamicPanel" Margin="0,4">

                    <!-- MOUSE fields (CLICK, DBLCLICK, RIGHTCLICK, MOVE) -->
                    <StackPanel x:Name="PanelMouse">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="X:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtX" Style="{DynamicResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
                            <Label Grid.Column="2" Content="Y:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" x:Name="TxtY" Style="{DynamicResource DarkTextBoxStyle}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Buton:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbButton" Style="{DynamicResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="left" IsSelected="True"/>
                                <ComboBoxItem Content="right"/>
                                <ComboBoxItem Content="middle"/>
                            </ComboBox>
                        </Grid>

                        <!-- ═══════════════════════════════════════════════════════
                             Mouse Position Tracker — Faza 8
                             Echivalent Python: tracker live X/Y + buton "Captează"
                             Vizibil DOAR pentru: CLICK, DBLCLICK, RIGHTCLICK, MOVE, SCROLL
                             ═══════════════════════════════════════════════════════ -->
                        <Border x:Name="MouseTrackerPanel"
                                Background="#252540"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Live coordinates display -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖱 Mouse:  X=" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="TxtMouseX"
                                               Text="0"
                                               Foreground="#009999"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               MinWidth="45"/>
                                    <TextBlock Text="  Y=" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="TxtMouseY"
                                               Text="0"
                                               Foreground="#009999"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               MinWidth="45"/>
                                </StackPanel>

                                <!-- Capture button -->
                                <Button Grid.Column="1"
                                        x:Name="BtnCapturePos"
                                        Content="📍 Captează poziție"
                                        Background="#009999"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        BorderBrush="#007777"
                                        BorderThickness="1"
                                        Padding="10,5"
                                        FontSize="11"
                                        Cursor="Hand"
                                        Click="BtnCapturePos_Click"
                                        Style="{x:Null}"/>
                            </Grid>
                        </Border>
                        <!-- ═══════════════════════════════════════════════════════ -->

                    </StackPanel>

                    <!-- KEY fields -->
                    <StackPanel x:Name="PanelKey">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Combinatie taste:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtKeyCombo"
                                    Style="{DynamicResource DarkTextBoxStyle}"
                                    Tag="ex: ctrl+c, alt+F4, enter"/>
                        </Grid>
                    </StackPanel>

                    <!-- TYPE fields -->
                    <StackPanel x:Name="PanelType">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Text de tastat:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtTextInput"
                                     Style="{DynamicResource DarkTextBoxStyle}"
                                     Tag="ctrl+c, alt+F4, enter"/>

                        </Grid>
                    </StackPanel>

                    <!-- SCROLL fields -->
                    <StackPanel x:Name="PanelScroll">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Scroll X:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtScrollDx" Style="{DynamicResource DarkTextBoxStyle}" Text="0" Margin="0,0,8,0"/>
                            <Label Grid.Column="2" Content="Scroll Y:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" x:Name="TxtScrollDy" Style="{DynamicResource DarkTextBoxStyle}" Text="3"/>
                        </Grid>

                        <!-- Mouse Tracker pentru SCROLL (acelasi bloc, refolosit via cod) -->
                        <Border x:Name="ScrollTrackerPanel"
                                Background="#252540"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖱 Mouse:  X=" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="TxtScrollMouseX"
                                               Text="0"
                                               Foreground="#009999"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               MinWidth="45"/>
                                    <TextBlock Text="  Y=" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="TxtScrollMouseY"
                                               Text="0"
                                               Foreground="#009999"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               MinWidth="45"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="BtnCaptureScrollPos"
                                        Content="📍 Captează poziție"
                                        Background="#009999"
                                        Foreground="White"
                                        BorderBrush="#007777"
                                        BorderThickness="1"
                                        Padding="10,5"
                                        FontSize="11"
                                        Cursor="Hand"
                                        Click="BtnCaptureScrollPos_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- QUESTION fields -->
                    <StackPanel x:Name="PanelQuestion">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Intrebare:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtQuestionText"
                                     Style="{DynamicResource DarkTextBoxStyle}"
                                     Tag="ctrl+c, alt+F4, enter"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Butoane:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtQuestionButtons"
                                     Style="{DynamicResource DarkTextBoxStyle}"
                                     Text="Continua,Opreste,Sari"
                                     Tag="Butoane separate prin virgula"/>
                        </Grid>
                    </StackPanel>

                    <!-- BROWSER fields -->
                    <StackPanel x:Name="PanelBrowser">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Selector / URL:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtBrowserSelector"
                                     Style="{DynamicResource DarkTextBoxStyle}"
                                     Tag="CSS selector sau URL"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Valoare:" Style="{DynamicResource DarkLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtBrowserValue"
                                     Style="{DynamicResource DarkTextBoxStyle}"
                                     Tag="Valoare pentru fill/navigate"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Common fields -->
        <GroupBox Grid.Row="3" Header="Setari comune" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,8">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <Label Content="Delay inainte (s):" Style="{DynamicResource DarkLabelStyle}"/>
                    <TextBox x:Name="TxtDelayBefore" Text="0.0" Style="{DynamicResource DarkTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                    <Label Content="Delay dupa (s):" Style="{DynamicResource DarkLabelStyle}"/>
                    <TextBox x:Name="TxtDelayAfter" Text="0.0" Style="{DynamicResource DarkTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Label Content="Monitor ID:" Style="{DynamicResource DarkLabelStyle}"/>
                    <TextBox x:Name="TxtMonitorId" Text="0" Style="{DynamicResource DarkTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                    <CheckBox x:Name="ChkSkip" Content="Skip pas"
                              Style="{DynamicResource DarkCheckBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Label Content="Comentariu:" Style="{DynamicResource DarkLabelStyle}"/>
                    <TextBox x:Name="TxtComment" Style="{DynamicResource DarkTextBoxStyle}"
                             Tag="Comentariu optional..."/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="✅ OK"
                    Style="{DynamicResource SuccessButtonStyle}"
                    MinWidth="100" Margin="0,0,8,0"
                    Click="BtnOk_Click"/>
            <Button Content="❌ Anuleaza"
                    Style="{DynamicResource NeutralButtonStyle}"
                    MinWidth="100"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

