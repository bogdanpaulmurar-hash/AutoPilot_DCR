<Window x:Class="AutoPilotDC.UI.Overlays.RunIndicatorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="180" Height="55"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="20" Top="90">

    <Border Background="#CC0F3460"
            CornerRadius="8"
            BorderBrush="#009999"
            BorderThickness="1"
            Padding="12,8">
        <TextBlock x:Name="TxtIter"
                   Text="? 1 / 1"
                   Foreground="#00C896"
                   FontFamily="Segoe UI"
                   FontSize="13"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</Window>
