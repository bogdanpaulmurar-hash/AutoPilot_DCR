<Window x:Class="AutoPilotDC.UI.Overlays.SimulatorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimulatorOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        IsHitTestVisible="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="0" Top="0">

    <Canvas x:Name="MainCanvas" Background="Transparent">

        <!-- Cerc animat (pulse) la coordonatele pasului curent -->
        <Ellipse x:Name="PulseCircle"
                 Width="40" Height="40"
                 Fill="#806A5ACD"
                 Stroke="#6A5ACD"
                 StrokeThickness="2"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Cerc interior (centru) -->
        <Ellipse x:Name="InnerCircle"
                 Width="12" Height="12"
                 Fill="#6A5ACD"
                 Visibility="Collapsed"/>

        <!-- Tooltip cu detalii pas -->
        <Border x:Name="TooltipBorder"
                Background="#CC1B1B2E"
                BorderBrush="#6A5ACD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Visibility="Collapsed"
                MaxWidth="280">
            <StackPanel>
                <TextBlock x:Name="TxtStepType"
                           Foreground="#6A5ACD"
                           FontWeight="Bold"
                           FontSize="12"
                           FontFamily="Segoe UI"/>
                <TextBlock x:Name="TxtDescription"
                           Foreground="#E0E0E0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtCoords"
                           Foreground="#B4B4C4"
                           FontSize="10"
                           FontFamily="Segoe UI Mono"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtDelay"
                           Foreground="#B4B4C4"
                           FontSize="10"
                           FontFamily="Segoe UI"
                           Margin="0,1,0,0"/>
            </StackPanel>
        </Border>

    </Canvas>
</Window>
