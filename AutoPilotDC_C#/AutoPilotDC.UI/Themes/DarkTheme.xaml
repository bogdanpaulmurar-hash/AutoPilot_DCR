<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==============================================================-
         AutoPilot DC � Dark Theme (Siemens Teal #009999)
         Identic cu COLORS_DARK din Python config/__init__.py
    ================================================================ -->

    <!-- Culori principale -->
    <Color x:Key="BgMainColor">#1B1B2E</Color>
    <Color x:Key="BgPanelColor">#16213E</Color>
    <Color x:Key="BgCardColor">#0F3460</Color>
    <Color x:Key="BgInputColor">#1A1A2E</Color>
    <Color x:Key="BorderColor">#2A2A4A</Color>
    <Color x:Key="PrimaryColor">#009999</Color>
    <Color x:Key="PrimaryHoverColor">#00BBBB</Color>
    <Color x:Key="PrimaryLightColor">#003333</Color>
    <Color x:Key="AccentColor">#00D4FF</Color>
    <Color x:Key="SuccessColor">#00C896</Color>
    <Color x:Key="SuccessHoverColor">#00E6AA</Color>
    <Color x:Key="WarningColor">#FFB347</Color>
    <Color x:Key="DangerColor">#E05252</Color>
    <Color x:Key="DangerHoverColor">#FF6666</Color>
    <Color x:Key="EmergencyColor">#8B0000</Color>
    <Color x:Key="TextColor">#E0E0F0</Color>
    <Color x:Key="TextDimColor">#A0A0C0</Color>
    <Color x:Key="TextMutedColor">#8C8CAC</Color>
    <Color x:Key="RowEvenColor">#1E1E35</Color>
    <Color x:Key="RowOddColor">#252540</Color>
    <Color x:Key="RowActiveColor">#003355</Color>
    <Color x:Key="RowErrorColor">#3D0000</Color>
    <Color x:Key="RowSkipColor">#2A2A1A</Color>
    <Color x:Key="SeparatorColor">#2A2A4A</Color>

    <!-- SolidColorBrush -->
    <SolidColorBrush x:Key="BgMainBrush"         Color="{StaticResource BgMainColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush"        Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgCardBrush"         Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgInputBrush"        Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"        Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"        Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"        Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"         Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="EmergencyBrush"      Color="{StaticResource EmergencyColor}"/>
    <SolidColorBrush x:Key="TextBrush"           Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"        Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="RowEvenBrush"        Color="{StaticResource RowEvenColor}"/>
    <SolidColorBrush x:Key="RowOddBrush"         Color="{StaticResource RowOddColor}"/>
    <SolidColorBrush x:Key="RowActiveBrush"      Color="{StaticResource RowActiveColor}"/>
    <SolidColorBrush x:Key="RowErrorBrush"       Color="{StaticResource RowErrorColor}"/>
    <SolidColorBrush x:Key="RowSkipBrush"        Color="{StaticResource RowSkipColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush"      Color="{StaticResource SeparatorColor}"/>
    <!-- selectie: text alb pe teal inchis (contrast > 4.5:1) -->
    <SolidColorBrush x:Key="SelectionBrush"      Color="#007777"/>
    <!-- butoane: fundaluri destul de inchise pentru text alb (contrast >= 4.5:1) -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush"   Color="#007777"/>
    <SolidColorBrush x:Key="ButtonSuccessBrush"   Color="#00785A"/>
    <SolidColorBrush x:Key="ButtonDangerBrush"    Color="#C62828"/>

    <!-- == Button Style (Primary � Siemens Teal) == -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource ButtonPrimaryBrush}"/>
        <Setter Property="Foreground"   Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="HoverLayer" Background="#26FFFFFF" CornerRadius="4" Visibility="Collapsed"/>
                        <Border x:Name="FocusRing" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="4" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == Button Style (Danger) == -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ButtonDangerBrush}"/>
    </Style>

    <!-- == Button Style (Emergency) == -->
    <Style x:Key="EmergencyButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource EmergencyBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- == Button Style (Success) == -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ButtonSuccessBrush}"/>
    </Style>

    <!-- == Button Style (Neutral/Gray) == -->
    <Style x:Key="NeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#3A3A5A"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- == TextBox Style == -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background"       Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="6,4"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="CaretBrush"       Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="SelectionBrush"   Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- == Label Style == -->
    <Style x:Key="DarkLabelStyle" TargetType="Label">
        <Setter Property="Foreground"  Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Padding"     Value="0,2"/>
    </Style>

    <!-- == TabControl Style == -->
    <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
        <Setter Property="Background"  Value="{StaticResource BgMainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Padding"     Value="0"/>
    </Style>

    <!-- == TabItem Style == -->
    <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background"  Value="{StaticResource BgPanelBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="14,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background"
                                    Value="{StaticResource BgMainBrush}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background"
                                    Value="{StaticResource BgCardBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == DataGrid Style == -->
    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background"              Value="{StaticResource BgMainBrush}"/>
        <Setter Property="Foreground"              Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"             Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="RowBackground"           Value="{StaticResource RowEvenBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource RowOddBrush}"/>
        <Setter Property="FontFamily"              Value="Segoe UI"/>
        <Setter Property="FontSize"                Value="12"/>
        <Setter Property="SelectionMode"           Value="Single"/>
        <Setter Property="HeadersVisibility"       Value="Column"/>
        <Setter Property="AutoGenerateColumns"     Value="False"/>
        <Setter Property="CanUserAddRows"          Value="False"/>
        <Setter Property="CanUserDeleteRows"       Value="False"/>
    </Style>

    <!-- == DataGrid Column Header Style == -->
    <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background"   Value="{StaticResource BgCardBrush}"/>
        <Setter Property="Foreground"   Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Padding"      Value="8,6"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- == ScrollBar Style (minimal) == -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
        <Setter Property="Width"      Value="8"/>
    </Style>

    <!-- == Slider Style == -->
    <Style x:Key="DarkSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- == CheckBox Style == -->
    <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- == GroupBox Style == -->
    <Style x:Key="DarkGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground"      Value="{StaticResource TextDimBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
    </Style>

    <!-- == Separator Style == -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource SeparatorBrush}"/>
    </Style>

</ResourceDictionary>
