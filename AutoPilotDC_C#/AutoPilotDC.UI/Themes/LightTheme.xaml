<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==============================================================-
         AutoPilot DC � Light Theme (Siemens Teal #009999)
         Identic cu COLORS_LIGHT din Python config/__init__.py
    ================================================================ -->

    <SolidColorBrush x:Key="BgMainBrush"       Color="#F0F0F5"/>
    <SolidColorBrush x:Key="BgPanelBrush"      Color="#E0E0EA"/>
    <SolidColorBrush x:Key="BgCardBrush"       Color="#D0D0E0"/>
    <SolidColorBrush x:Key="BgInputBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#C0C0D0"/>
    <SolidColorBrush x:Key="PrimaryBrush"      Color="#009999"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#007777"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="#006699"/>
    <SolidColorBrush x:Key="SuccessBrush"      Color="#007755"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="#CC8800"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="#CC3333"/>
    <SolidColorBrush x:Key="EmergencyBrush"    Color="#8B0000"/>
    <SolidColorBrush x:Key="TextBrush"         Color="#1B1B2E"/>
    <SolidColorBrush x:Key="TextDimBrush"      Color="#404060"/>
    <SolidColorBrush x:Key="TextMutedBrush"    Color="#5C5C6E"/>
    <SolidColorBrush x:Key="RowEvenBrush"      Color="#F5F5FA"/>
    <SolidColorBrush x:Key="RowOddBrush"       Color="#EAEAF0"/>
    <SolidColorBrush x:Key="RowActiveBrush"    Color="#CCE5FF"/>
    <SolidColorBrush x:Key="RowErrorBrush"     Color="#FFE0E0"/>
    <SolidColorBrush x:Key="RowSkipBrush"      Color="#FFFFF0"/>
    <SolidColorBrush x:Key="SeparatorBrush"    Color="#C0C0D0"/>
    <SolidColorBrush x:Key="SelectionBrush"    Color="#007777"/>
    <!-- butoane: fundaluri destul de inchise pentru text alb (contrast >= 4.5:1) -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush"   Color="#007777"/>
    <SolidColorBrush x:Key="ButtonSuccessBrush"   Color="#00785A"/>
    <SolidColorBrush x:Key="ButtonDangerBrush"    Color="#C62828"/>

    <!-- Refolosim stilurile din DarkTheme � culorile sunt override -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource ButtonPrimaryBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="12,6"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="HoverLayer" Background="#26FFFFFF" CornerRadius="4" Visibility="Collapsed"/>
                        <Border x:Name="FocusRing" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="4" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButtonStyle"    TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ButtonDangerBrush}"/>
    </Style>
    <Style x:Key="EmergencyButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource EmergencyBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SuccessButtonStyle"   TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ButtonSuccessBrush}"/>
    </Style>
    <Style x:Key="NeutralButtonStyle"   TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#AAAACC"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="13"/>
    </Style>

    <Style x:Key="DarkLabelStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="12"/>
    </Style>

    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource BgMainBrush}"/>
        <Setter Property="Foreground"               Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="RowBackground"            Value="{StaticResource RowEvenBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource RowOddBrush}"/>
        <Setter Property="FontFamily"               Value="Segoe UI"/>
        <Setter Property="FontSize"                 Value="12"/>
        <Setter Property="AutoGenerateColumns"      Value="False"/>
        <Setter Property="CanUserAddRows"           Value="False"/>
    </Style>

    <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background"  Value="{StaticResource BgCardBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Padding"     Value="8,6"/>
    </Style>

    <Style x:Key="DarkGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground"      Value="{StaticResource TextDimBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8"/>
    </Style>

    <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
        <Setter Property="Background"  Value="{StaticResource BgMainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background"  Value="{StaticResource BgPanelBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="14,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background"
                                    Value="{StaticResource BgMainBrush}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

</ResourceDictionary>
