<Window x:Class="AutoPilotDC.UI.Studio.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoPilotDC.UI.Studio"
        Title="AutoPilot DC — Studio RPR"
        Height="860" Width="1440" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Stil buton bara de unelte: compact, lizibil -->
        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- Element din arbore -->
        <HierarchicalDataTemplate DataType="{x:Type local:NodeItem}" ItemsSource="{Binding Children}">
            <Border x:Name="Row" CornerRadius="3" Padding="4,2" Opacity="{Binding ItemOpacity}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Number}" Foreground="{DynamicResource TextMutedBrush}" Width="26" TextAlignment="Right" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontFamily="Segoe UI Emoji"/>
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="  💬" Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding Comment}" FontFamily="Segoe UI Emoji"/>
                </StackPanel>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBranch}" Value="True">
                    <Setter TargetName="TitleText" Property="FontStyle" Value="Italic"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Row" Property="Background" Value="#FF9900"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="#000028"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="Row" Property="BorderBrush" Value="#00C896"/>
                    <Setter TargetName="Row" Property="BorderThickness" Value="0,0,0,2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="Row" Property="Background" Value="#B00020"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- bara de unelte -->
            <RowDefinition Height="*"/>      <!-- continut -->
            <RowDefinition Height="5"/>      <!-- splitter -->
            <RowDefinition Height="200"/>    <!-- log -->
            <RowDefinition Height="Auto"/>   <!-- status -->
        </Grid.RowDefinitions>

        <!-- ═════════ BARA DE UNELTE ═════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <TextBlock Text="🧩 Studio RPR" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="4,0,12,0"/>

                <Button Style="{StaticResource ToolBtn}" Content="📄 Nou" Click="New_Click" ToolTip="Rutina noua (Ctrl+N)"/>
                <Button Style="{StaticResource ToolBtn}" Content="📂 Deschide" Click="Open_Click" ToolTip="Deschide rutina (Ctrl+O) — accepta si rutinele vechi v3.9"/>
                <Button Style="{StaticResource ToolBtn}" Content="💾 Salveaza" Click="Save_Click" ToolTip="Salveaza (Ctrl+S)"/>
                <Button Style="{StaticResource ToolBtn}" Content="Salveaza ca..." Click="SaveAs_Click"/>
                <Button Style="{StaticResource ToolBtn}" Content="📚 Exemple" Click="Examples_Click" ToolTip="Instaleaza si deschide rutinele exemplu"/>

                <Separator Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}"/>

                <Button x:Name="BtnRun"   Style="{StaticResource SuccessButtonStyle}" Margin="2" Padding="12,5" Content="▶ Ruleaza" Click="Run_Click" ToolTip="Ruleaza rutina (F5)"/>
                <Button x:Name="BtnPause" Style="{StaticResource ToolBtn}" Content="⏸ Pauza" Click="Pause_Click" IsEnabled="False" ToolTip="Pauza / Reluare (Ctrl+F11)"/>
                <Button x:Name="BtnStep"  Style="{StaticResource ToolBtn}" Content="⏭ Pas cu pas" Click="Step_Click" ToolTip="Ruleaza cate un pas (porneste in pauza; apasa din nou pentru urmatorul)"/>
                <Button x:Name="BtnStop"  Style="{StaticResource DangerButtonStyle}" Margin="2" Padding="12,5" Content="⏹ Stop" Click="Stop_Click" IsEnabled="False" ToolTip="Opreste (Ctrl+F12)"/>

                <Separator Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}"/>

                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="2" Padding="10,5" Content="🎯 Spy Web" Click="SpyWeb_Click" ToolTip="Marcheaza un element dintr-o pagina web"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="2" Padding="10,5" Content="🎯 Spy SAP" Click="SpySap_Click" ToolTip="Marcheaza un element din SAP GUI (F2 captureaza)"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="2" Padding="10,5" Content="🎯 Spy Desktop" Click="SpyDesktop_Click" ToolTip="Marcheaza un element dintr-o aplicatie Windows (F2 captureaza)"/>
                <Button x:Name="BtnRecord" Style="{StaticResource DangerButtonStyle}" Margin="2" Padding="10,5" Content="⏺ Inregistreaza Web" Click="Record_Click" ToolTip="Click-urile si textele din browser devin pasi + obiecte"/>

                <Separator Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}"/>

                <CheckBox x:Name="ChkHighlight" Content="Marcheaza inainte de actiune" VerticalAlignment="Center" Margin="6,0" Checked="Highlight_Changed" Unchecked="Highlight_Changed"/>
                <Button Style="{StaticResource ToolBtn}" Content="⏰ Programeaza" Click="Schedule_Click" ToolTip="Ruleaza automat la o ora (Windows Task Scheduler)"/>
                <Button Style="{StaticResource ToolBtn}" Content="⚙ Setari" Click="Settings_Click"/>
                <Button Style="{StaticResource ToolBtn}" Content="❓ Ghid" Click="Help_Click" ToolTip="Instructiuni pas cu pas (F1)"/>
            </WrapPanel>
        </Border>

        <!-- ═════════ CONTINUT ═════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="430" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── Stanga: blocuri + obiecte ── -->
            <TabControl Grid.Column="0" Style="{DynamicResource DarkTabControlStyle}" Background="{DynamicResource BgPanelBrush}">
                <TabItem Header="🧱 Pasi" Style="{DynamicResource DarkTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Toolbox" Margin="8"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="🎯 Obiecte" Style="{DynamicResource DarkTabItemStyle}">
                    <DockPanel Margin="6">
                        <TextBox x:Name="ObjectFilter" DockPanel.Dock="Top" Margin="0,0,0,4" TextChanged="ObjectFilter_TextChanged" ToolTip="Cauta obiect"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <Button Style="{StaticResource ToolBtn}" Content="👁 Arata" Click="ObjShow_Click" ToolTip="Marcheaza obiectul pe ecran"/>
                            <Button Style="{StaticResource ToolBtn}" Content="✎ Editeaza" Click="ObjEdit_Click"/>
                            <Button Style="{StaticResource ToolBtn}" Content="➕ Pas" Click="ObjAddStep_Click" ToolTip="Adauga un pas Click pe obiect"/>
                            <Button Style="{StaticResource ToolBtn}" Content="🗑 Sterge" Click="ObjDelete_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="ObjectList" MouseDoubleClick="ObjEdit_Click" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5">
                                            <Run Text="{Binding Technology, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding ElementType, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- ── Centru: arborele rutinei ── -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock x:Name="RoutineTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource ToolBtn}" Content="⬆" Click="MoveUp_Click" ToolTip="Muta sus (Ctrl+Sus)"/>
                            <Button Style="{StaticResource ToolBtn}" Content="⬇" Click="MoveDown_Click" ToolTip="Muta jos (Ctrl+Jos)"/>
                            <Button Style="{StaticResource ToolBtn}" Content="⧉" Click="Duplicate_Click" ToolTip="Duplica (Ctrl+D)"/>
                            <Button Style="{StaticResource ToolBtn}" Content="⏯" Click="ToggleEnabled_Click" ToolTip="Activeaza / omite pasul (Spatiu)"/>
                            <Button Style="{StaticResource ToolBtn}" Content="🗑" Click="Delete_Click" ToolTip="Sterge (Delete)"/>
                            <Button Style="{StaticResource ToolBtn}" Content="⚙ Rutina" Click="RoutineSettings_Click" ToolTip="Setarile rutinei si variabile"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <TreeView x:Name="Tree" ItemsSource="{Binding TreeItems}" SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewKeyDown="Tree_PreviewKeyDown" Padding="4" FontSize="13.5">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

            <!-- ── Dreapta: proprietati ── -->
            <Border Grid.Column="4" Background="{DynamicResource BgPanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PropertiesHost" Margin="12"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- ═════════ LOG ═════════ -->
        <TabControl Grid.Row="3" Style="{DynamicResource DarkTabControlStyle}">
            <TabItem Header="📋 Log rulare" Style="{DynamicResource DarkTabItemStyle}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="4">
                        <Button Style="{StaticResource ToolBtn}" Content="📤 Export Excel" Click="ExportLog_Click"/>
                        <Button Style="{StaticResource ToolBtn}" Content="📁 Rezultate" Click="OpenOutput_Click" ToolTip="Deschide folderul cu capturi si loguri"/>
                        <Button Style="{StaticResource ToolBtn}" Content="🧹 Goleste" Click="ClearLog_Click"/>
                    </WrapPanel>
                    <ListView x:Name="LogList" FontFamily="Consolas" FontSize="12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="#5C0010"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background" Value="#4A3A00"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ora"   Width="70"  DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="Nivel" Width="70"  DisplayMemberBinding="{Binding Level}"/>
                                <GridViewColumn Header="Rand"  Width="50"  DisplayMemberBinding="{Binding Row}"/>
                                <GridViewColumn Header="Pas"   Width="320" DisplayMemberBinding="{Binding Step}"/>
                                <GridViewColumn Header="Mesaj" Width="700" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="🔤 Variabile" Style="{DynamicResource DarkTabItemStyle}">
                <ListView x:Name="VarList" FontFamily="Consolas" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Variabila" Width="260" DisplayMemberBinding="{Binding Key}"/>
                            <GridViewColumn Header="Valoare (dupa ultima rulare)" Width="800" DisplayMemberBinding="{Binding Value}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <!-- ═════════ STATUS ═════════ -->
        <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{DynamicResource TextDimBrush}"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextBrush}" Text="Gata."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
