<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoPilotDC.Drivers.Windows — automatizare Windows pentru motorul RPR:
      - DesktopUiDriver: aplicatii desktop prin UI Automation (FlaUI.UIA3)
      - SapUiDriver:     SAP GUI prin SAP GUI Scripting (COM, fara referinte la SAP)
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoPilotDC.Drivers.Windows</RootNamespace>
    <AssemblyName>AutoPilotDC.Drivers.Windows</AssemblyName>
    <Version>4.0.0</Version>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoPilotDC.Rpr\AutoPilotDC.Rpr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
</Project>
