<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoPilotDC.Drivers.Web — automatizare web pentru motorul RPR:
      - PlaywrightUiDriver (recomandat): Spy cu marcare, Recorder, locatori multipli, iframe-uri
      - SeleniumUiDriver: aceeasi interfata, pentru cazurile in care e nevoie de WebDriver
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoPilotDC.Drivers.Web</RootNamespace>
    <AssemblyName>AutoPilotDC.Drivers.Web</AssemblyName>
    <Version>4.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoPilotDC.Rpr\AutoPilotDC.Rpr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Aceeasi versiune ca proiectul vechi AutoPilotDC.Playwright, ca sa nu apara conflicte -->
    <PackageReference Include="Microsoft.Playwright" Version="1.44.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.25.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts\apdc-spy.js" LogicalName="AutoPilotDC.Drivers.Web.apdc-spy.js" />
  </ItemGroup>
</Project>
