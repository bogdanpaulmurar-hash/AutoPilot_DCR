               VerticalAlignment="Center"
               Margin="8,0,4,0"
               ToolTip="Simuleaza fara actiuni reale (mouse/keyboard)"/>

     <!-- Buton Pas Urmator (vizibil doar cand Simulator e activ) -->
     <Button Content="? Pas Urmator"
             Command="{Binding NextStepCmd}"
             Background="#4A4A8A"
             Foreground="White"
             Height="32"
             Padding="10,0"
             Margin="4,0"
             Cursor="Hand"
             BorderThickness="0"
             FontSize="12"
             FontWeight="SemiBold"
             ToolTip="Avanseaza la pasul urmator in modul manual">
         <Button.Style>
             <Style TargetType="Button">
                 <Setter Property="Visibility" Value="Collapsed"/>
                 <Style.Triggers>
                     <DataTrigger Binding="{Binding IsNextStepVisible}" Value="True">
                         <Setter Property="Visibility" Value="Visible"/>
                     </DataTrigger>
                 </Style.Triggers>
             </Style>
         </Button.Style>
     </Button>

